# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs (optional - defaults provided in hardhat.config.ts)
SEISMIC_RPC_URL=https://gcp-1.seismictest.net/rpc
SEISMIC_WS_URL=wss://gcp-1.seismictest.net/ws
SEISMIC_EXPLORER_API_URL=https://seismic-testnet.socialscan.io/api
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# SocialScan API key for contract verification (optional)
SEISMIC_EXPLORER_API_KEY=your_socialscan_api_key_here

# Contract addresses (required for scripts)
MOCK_USDL_ADDRESS=0x...  # MockUSDL token address
FACTORY_ADDRESS=0x...    # BetFactoryCOFI address

# For mint-usdl.ts script
USDL_ADDRESS=0x...       # Same as MOCK_USDL_ADDRESS
RECIPIENT=0x...          # Address to receive minted tokens
